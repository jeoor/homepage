# 天气 Key
## 高德开放平台 Key (优先级更高)
## 请前往 高德开放平台注册 Web服务 Key
## 请注意不是 Web端 (JS API)，免费申请，每日上限 5000 次
VITE_WEATHER_KEY = "0ba7ab0655af10bacdb1a9642a06c2b5"

## 心知天气 API Key (备用)
## 若高德 Key 为空，则使用心知天气 API
## 申请地址：https://www.seniverse.com/
VITE_SENIVERSE_KEY = "P8Mk50ja66i8z0cIM"

# 建站日期
## 若不需要，请设为空即可
## 请按照 YYYY-MM-DD 格式填写或者仅填写年份 YYYY
VITE_SITE_START = "2026-02-13"

# ICP 备案号
## 若不需要，请设为空即可
